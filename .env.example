# Google Calendar OAuth (PKCE)
# Create a project at https://console.cloud.google.com/
# Enable the "Google Calendar API"
# Create an OAuth 2.0 Client ID (Web application)
# Add your app's origin to "Authorized JavaScript origins"
# Add your app's URL to "Authorized redirect URIs"
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: override the redirect URI (defaults to current page URL)
# VITE_GOOGLE_REDIRECT_URI=https://your-domain.com/dayboard/

# Spotify OAuth (PKCE)
# Create an app at https://developer.spotify.com/dashboard
# Add your local and production redirect URIs in the Spotify app settings
# Frontend uses the client ID only. Do not expose the client secret in Vite env vars.
VITE_SPOTIFY_CLIENT_ID=your-spotify-client-id
#
# VITE_SPOTIFY_REDIRECT_URI=https://your-domain.com/dayboard/

# Optional: override the flights backend endpoint.
# Defaults to the local Vite proxy at /api/flights, which forwards to OpenSky.
# VITE_FLIGHTS_API_BASE=https://opensky-network.org/api
